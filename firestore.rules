rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function googleUser() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return googleUser()
        && request.auth.token.email == 'gpeluso03@gmail.com';
    }

    match /utenti/{uid} {
      allow read, write: if signedIn()
        && request.auth.uid == uid;
    }

    match /notifiche/{token} {
      allow create, update: if request.resource.data.token == token
        && request.resource.data.keys().hasOnly([
          'token',
          'aggiornato'
        ]);

      allow delete: if true;
      allow read: if false;
    }

    match /reportQuota/{uid} {

      function reportPath() {
        return /databases/$(database)/documents/reports/$(request.resource.data.lastReportId);
      }

      function correctCount() {
        return !exists(
          /databases/$(database)/documents/reportQuota/$(uid)
        )
          ? request.resource.data.count == 1
          : (
              // 12 ore dopo l'ultima segnalazione il conteggio riparte da 1:
              // chi le finisce tutte e 5 aspetta 12 ore dalla quinta.
              request.time >= resource.data.updatedAt + duration.value(12, 'h')
                ? request.resource.data.count == 1
                : request.resource.data.count == resource.data.count + 1
            );
      }

      allow get: if googleUser()
        && request.auth.uid == uid;

      allow list, delete: if false;

      allow create, update: if googleUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'count',
          'lastReportId',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'count',
          'lastReportId',
          'updatedAt'
        ])
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 5
        && request.resource.data.lastReportId is string
        && request.resource.data.updatedAt == request.time
        && correctCount()
        && !exists(reportPath())
        && getAfter(reportPath()).data.userId == uid
        && getAfter(reportPath()).data.createdAt == request.time;
    }

    match /reports/{reportId} {

      function quotaPath() {
        return /databases/$(database)/documents/reportQuota/$(request.auth.uid);
      }

      allow create: if googleUser()
        && request.resource.data.keys().hasOnly([
          'userId',
          'authorEmail',
          'title',
          'message',
          'contact',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId',
          'authorEmail',
          'title',
          'message',
          'contact',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 550
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(quotaPath()).data.lastReportId == reportId
        && getAfter(quotaPath()).data.updatedAt == request.time;

      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      // chi ha inviato la segnalazione può solo segnare che ha risposto (insieme al messaggio, vedi "messaggi"):
      // ultima risposta adesso, id del messaggio appena scritto, al massimo una risposta ogni 30 secondi
      allow update: if googleUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['userReplyAt', 'lastReplyId', 'updatedAt'])
        && request.resource.data.userReplyAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastReplyId is string
        && existsAfter(/databases/$(database)/documents/reports/$(reportId)/messaggi/$(request.resource.data.lastReplyId))
        && (
          !('userReplyAt' in resource.data)
          || request.time > resource.data.userReplyAt + duration.value(30, 's')
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'adminComment',
            'lastAdminMsgId',
            'updatedAt'
          ])
        && request.resource.data.status in [
          'new',
          'in_progress',
          'rejected',
          'resolved'
        ]
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['adminComment'])
          || (
            request.resource.data.adminComment is string
            && request.resource.data.adminComment.size() <= 1500
          )
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      /* Conversazione della segnalazione: messaggi dell'amministratore e di chi l'ha inviata.
         La leggono solo loro due. Nessuno modifica o cancella i messaggi (li toglie la pulizia dopo 30 giorni). */
      match /messaggi/{msgId} {
        function report() {
          return get(/databases/$(database)/documents/reports/$(reportId)).data;
        }
        function validMessage(who) {
          return request.resource.data.keys().hasOnly(['da', 'uid', 'testo', 'createdAt'])
            && request.resource.data.keys().hasAll(['da', 'uid', 'testo', 'createdAt'])
            && request.resource.data.da == who
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.testo is string
            && request.resource.data.testo.size() >= 1
            && request.resource.data.createdAt == request.time;
        }

        allow read: if signedIn()
          && (isAdmin() || report().userId == request.auth.uid);

        allow create: if isAdmin()
          && validMessage('admin')
          && request.resource.data.testo.size() <= 1500;

        // l'utente scrive il messaggio e, nella stessa operazione, aggiorna la segnalazione (userReplyAt, lastReplyId)
        allow create: if googleUser()
          && report().userId == request.auth.uid
          && validMessage('utente')
          && request.resource.data.testo.size() <= 550
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.lastReplyId == msgId
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.userReplyAt == request.time;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}